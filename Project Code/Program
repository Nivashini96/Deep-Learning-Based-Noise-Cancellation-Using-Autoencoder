# ── CELL 7: Build U-Net Autoencoder Model ────────────────────────────────────
# @title Cell 7 — U-Net Convolutional Autoencoder Architecture

def build_unet(input_shape=(PATCH_SIZE, PATCH_SIZE, 1)):
    """
    U-Net Convolutional Autoencoder for spectrogram denoising.
    Skip connections let the decoder recover fine spectral detail
    that the bottleneck would otherwise discard.

    Input  → noisy mel-patch  [0, 1]
    Output → clean mel-patch  [0, 1]
    """
    inp = keras.Input(shape=input_shape, name='noisy_patch')

    def conv_block(x, filters, dropout=0.0):
        x = layers.Conv2D(filters, 3, padding='same')(x)
        x = layers.BatchNormalization()(x)
        x = layers.Activation('relu')(x)
        x = layers.Conv2D(filters, 3, padding='same')(x)
        x = layers.BatchNormalization()(x)
        x = layers.Activation('relu')(x)
        if dropout > 0:
            x = layers.Dropout(dropout)(x)
        return x

    # ── Encoder ───────────────────────────────────────────────────────────────
    e1 = conv_block(inp, 32);           p1 = layers.MaxPooling2D(2)(e1)   # 64×64
    e2 = conv_block(p1,  64);           p2 = layers.MaxPooling2D(2)(e2)   # 32×32
    e3 = conv_block(p2,  128, 0.1);     p3 = layers.MaxPooling2D(2)(e3)   # 16×16
    e4 = conv_block(p3,  256, 0.1);     p4 = layers.MaxPooling2D(2)(e4)   # 8×8

    # ── Bottleneck ────────────────────────────────────────────────────────────
    bn = conv_block(p4, 512, 0.2)                                          # 8×8

    # ── Decoder (transpose-conv + skip concatenation) ─────────────────────────
    d4 = layers.Conv2DTranspose(256, 2, strides=2, padding='same')(bn)
    d4 = layers.Concatenate()([d4, e4]); d4 = conv_block(d4, 256, 0.1)

    d3 = layers.Conv2DTranspose(128, 2, strides=2, padding='same')(d4)
    d3 = layers.Concatenate()([d3, e3]); d3 = conv_block(d3, 128, 0.1)

    d2 = layers.Conv2DTranspose(64,  2, strides=2, padding='same')(d3)
    d2 = layers.Concatenate()([d2, e2]); d2 = conv_block(d2, 64)

    d1 = layers.Conv2DTranspose(32,  2, strides=2, padding='same')(d2)
    d1 = layers.Concatenate()([d1, e1]); d1 = conv_block(d1, 32)

    # ── Output: sigmoid → [0, 1] ──────────────────────────────────────────────
    out = layers.Conv2D(1, 1, activation='sigmoid', name='clean_patch')(d1)

    return keras.Model(inp, out, name='UNet_Denoiser')

model = build_unet()
model.summary(line_length=90)

# ── Combined loss: 70% MSE + 30% SSIM loss ────────────────────────────────────
def ssim_loss(y_true, y_pred):
    return 1.0 - tf.reduce_mean(tf.image.ssim(y_true, y_pred, max_val=1.0))

def combined_loss(y_true, y_pred):
    return 0.7 * tf.reduce_mean(tf.square(y_true - y_pred)) + 0.3 * ssim_loss(y_true, y_pred)

model.compile(
    optimizer=keras.optimizers.Adam(LR),
    loss=combined_loss,
    metrics=['mae', tf.keras.metrics.MeanSquaredError(name='mse')]
)
