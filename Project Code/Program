# ── CELL 10: Define Metrics & Inference ───────────────────────────────────────
# @title Cell 10 — Metric Functions & Full Inference Pipeline

def compute_snr(clean, estimated):
    """Signal-to-Noise Ratio (dB). Higher = better."""
    n = min(len(clean), len(estimated))
    c, e = clean[:n], estimated[:n]
    noise_power  = np.mean((c - e) ** 2) + 1e-10
    signal_power = np.mean(c ** 2)
    return 10 * np.log10(signal_power / noise_power)

def compute_psnr(clean, estimated):
    """Peak SNR (dB). Higher = better."""
    n = min(len(clean), len(estimated))
    c, e = clean[:n], estimated[:n]
    mse = np.mean((c - e) ** 2)
    if mse < 1e-12:
        return float('inf')
    return 20 * np.log10(np.max(np.abs(c)) / (np.sqrt(mse) + 1e-10))

def compute_spec_ssim(mel_a, mel_b):
    """SSIM between two mel-spectrograms (range-normalised). Closer to 1 = better."""
    def _norm(s): return (s - s.min()) / (s.max() - s.min() + 1e-8)
    a, b = _norm(mel_a), _norm(mel_b)
    h, w = min(a.shape[0], b.shape[0]), min(a.shape[1], b.shape[1])
    return float(ssim(a[:h, :w], b[:h, :w], data_range=1.0))

def denoise_audio(noisy_audio):
    """
    Full inference pipeline:
      noisy waveform → mel-spec → normalise → patch → U-Net → reconstruct → waveform
    Returns: (denoised_wav, mel_noisy, mel_denoised)
    """
    mel_noisy              = wav_to_mel(noisy_audio)
    n_norm, mn, mx        = normalize_spec(mel_noisy)
    patches, coords, shape = extract_patches(n_norm)

    patches_out = model.predict(patches[..., np.newaxis], verbose=0)[..., 0]

    spec_denoised  = reconstruct_from_patches(patches_out, coords, shape)
    mel_denoised   = denormalize_spec(spec_denoised, mn, mx)
    audio_denoised = mel_to_wav(mel_denoised, SR, orig_len=len(noisy_audio))
    return audio_denoised, mel_noisy, mel_denoised

def apply_stat_nr(audio):
    """
    Statistical noise reduction via noisereduce.
    FIX: removed the invalid 'verbose' parameter that caused TypeError.
    """
    noise_clip = audio[:max(int(0.5 * SR), 1)]
    return nr.reduce_noise(
        y=audio,
        sr=SR,
        y_noise=noise_clip,
        prop_decrease=0.80,
        n_fft=N_FFT,
        hop_length=HOP_LENGTH,
    )

print("✅ Metric functions & inference pipeline defined.")

