# ── CELL 4: Noise Generators + Create Noisy Dataset ──────────────────────────
# @title Cell 4 — Synthetic Noise Generators & Noisy-Clean Pair Creation

def generate_white_noise(length, amplitude=1.0):
    return np.random.normal(0, amplitude, length).astype(np.float32)

def generate_pink_noise(length, amplitude=1.0):
    """1/f (pink) noise — IFFT method."""
    f = np.fft.rfftfreq(length)
    f[0] = 1e-10          # avoid divide-by-zero at DC
    power   = 1.0 / np.sqrt(f)
    phase   = np.random.uniform(0, 2 * np.pi, len(f))
    noise   = np.fft.irfft(power * np.exp(1j * phase), n=length).astype(np.float32)
    return noise / (np.max(np.abs(noise)) + 1e-8) * amplitude

def generate_brown_noise(length, amplitude=1.0):
    """Brownian (1/f²) noise — cumulative-sum method."""
    brown = np.cumsum(np.random.normal(0, 1, length)).astype(np.float32)
    brown -= brown.mean()
    return brown / (np.max(np.abs(brown)) + 1e-8) * amplitude

def generate_babble_noise(length, file_list, amplitude=1.0):
    """Babble: overlay of 3-6 random speech clips."""
    noise = np.zeros(length, dtype=np.float32)
    for _ in range(random.randint(3, 6)):
        seg, _ = librosa.load(random.choice(file_list), sr=SR, mono=True)
        if len(seg) < length:
            seg = np.tile(seg, (length // len(seg)) + 1)
        start = random.randint(0, max(len(seg) - length, 0))
        noise += seg[start : start + length]
    return noise / (np.max(np.abs(noise)) + 1e-8) * amplitude

def add_noise_at_snr(clean, noise, target_snr_db):
    """Scale noise to achieve a target SNR and mix with clean signal."""
    clean_rms          = np.sqrt(np.mean(clean ** 2)) + 1e-10
    noise_rms          = np.sqrt(np.mean(noise ** 2)) + 1e-10
    desired_noise_rms  = clean_rms / (10 ** (target_snr_db / 20.0))
    scaled_noise       = noise * (desired_noise_rms / noise_rms)
    return np.clip(clean + scaled_noise, -1.0, 1.0).astype(np.float32)

NOISE_FN_MAP = {
