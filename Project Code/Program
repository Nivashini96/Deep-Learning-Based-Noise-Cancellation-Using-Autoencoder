# ── CELL 5: Spectrogram Utilities ─────────────────────────────────────────────
# @title Cell 5 — Spectrogram Helper Functions

def wav_to_mel(audio, sr=SR):
    """Waveform → mel-spectrogram (dB scale, float32)."""
    mel    = librosa.feature.melspectrogram(
                 y=audio, sr=sr, n_fft=N_FFT,
                 hop_length=HOP_LENGTH, n_mels=N_MELS)
    return librosa.power_to_db(mel, ref=np.max).astype(np.float32)

def normalize_spec(spec):
    """Shift & scale mel-spec to [0, 1]. Returns (normed, min, max)."""
    mn, mx = spec.min(), spec.max()
    return (spec - mn) / (mx - mn + 1e-8), mn, mx

def denormalize_spec(spec_n, mn, mx):
    """Reverse the normalization."""
    return spec_n * (mx - mn) + mn

def mel_to_wav(mel_db, sr=SR, orig_len=None):
    """
    Mel-spectrogram (dB) → waveform.
    Uses librosa.feature.inverse.mel_to_audio which handles
    inverse-mel filtering + Griffin-Lim phase estimation internally.
    FIX: replaces the old mel_to_stft + griffinlim two-step call
         which could produce negative values causing nan/errors.
    """
    mel_power = librosa.db_to_power(mel_db)
    # Ensure no negative values (can appear after autoencoder denorm)
    mel_power = np.maximum(mel_power, 0.0)
    audio = librosa.feature.inverse.mel_to_audio(
                mel_power, sr=sr,
                n_fft=N_FFT, hop_length=HOP_LENGTH,
                n_iter=64, window='hann')
    if orig_len:
        audio = librosa.util.fix_length(audio, size=orig_len)
    return audio.astype(np.float32)

def extract_patches(spec_norm, size=PATCH_SIZE, step=PATCH_STEP):
    """Extract overlapping square patches; pad spec if needed."""
    H, W = spec_norm.shape
    # Pad so the spec is at least 'size' in each dimension
    padH = max(size, H + (size - H % size) % size)
    padW = max(size, W + (size - W % size) % size)
    padded = np.pad(spec_norm, ((0, padH - H), (0, padW - W)), mode='reflect')

    patches, coords = [], []
    for r in range(0, padH - size + 1, step):
        for c in range(0, padW - size + 1, step):
            patches.append(padded[r:r+size, c:c+size])
            coords.append((r, c, padH, padW))
    return np.array(patches, dtype=np.float32), coords, (H, W)

def reconstruct_from_patches(patches, coords, orig_shape, size=PATCH_SIZE):
    """Overlap-add reconstruction with a Hann window to smooth seams."""
    H, W           = orig_shape
    padH, padW     = coords[0][2], coords[0][3]
    recon          = np.zeros((padH, padW), np.float32)
    weight         = np.zeros((padH, padW), np.float32)
    win            = np.outer(np.hanning(size), np.hanning(size)).astype(np.float32)

    for patch, (r, c, _, _) in zip(patches, coords):
        recon [r:r+size, c:c+size] += patch * win
        weight[r:r+size, c:c+size] += win

    return (recon / np.maximum(weight, 1e-8))[:H, :W]

